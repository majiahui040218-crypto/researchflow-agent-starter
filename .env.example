# Safe defaults. Mock mode requires no API keys or external services.
RESEARCHFLOW_MODE=mock
RESEARCHFLOW_DB=.data/researchflow.sqlite
RESEARCHFLOW_MAX_SEARCHES=1
RESEARCHFLOW_LLM_RETRIES=0

# For live mode, choose a model ID supported by YOUR provider.
# See README.zh-CN.md for examples using USTC and other compatible APIs.
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
OPENAI_API_KEY=
TAVILY_API_KEY=

# Optional model HTTP proxy. For ClashX HTTP proxy on this Mac:
# RESEARCHFLOW_HTTP_PROXY=http://127.0.0.1:7890
# Leave unset to preserve V0.5's IPv4-direct connection behavior.
